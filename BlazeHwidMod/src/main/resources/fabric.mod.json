{
  "schemaVersion": 1,
  "id": "blazehwid",
  "version": "${version}",
  "name": "Blaze HWID Reporter",
  "description": "配合 BlazeHwidBan 服务端插件使用: 进服后上报本机机器码 (仅 SHA-256 哈希, 不上传任何原始硬件信息), 实现真正的硬件级防换号封禁。",
  "authors": ["Blaze"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["cn.blaze.hwidmod.BlazeHwidModClient"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": ">=26.1"
  }
}
